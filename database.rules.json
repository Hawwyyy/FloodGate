{
  "rules": {
    ".read": false,
    ".write": false,
    "eldroid": {
      "gates": {
        ".read": "auth != null",
        "$gateId": {
          "name": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider == 'password' && !data.exists() && newData.exists() && $gateId != 'gate1' && $gateId.matches(/^[a-z][a-z0-9_-]{0,39}$/)",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
          },
          "ledControl": {
            "command": {
              ".write": "auth != null && auth.token.firebase.sign_in_provider == 'password' && newData.exists()",
              ".validate": "newData.isString() && (newData.val() == 'ON' || newData.val() == 'OFF')"
            },
            "actualState": {
              ".write": "auth != null && root.child('gateDeviceUids').child($gateId).child(auth.uid).val() == true && newData.exists()",
              ".validate": "newData.isBoolean()"
            },
            "device": {
              ".write": "auth != null && root.child('gateDeviceUids').child($gateId).child(auth.uid).val() == true && newData.exists()",
              "lastUpdate": { ".validate": "newData.isNumber() && newData.val() == now" },
              "heartbeat": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "$other": { ".validate": false }
            },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        }
      },
      "ledControl": {
        ".read": "auth != null",
        "command": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && !root.child('eldroidDeviceUids').child(auth.uid).exists()",
          ".validate": "newData.isString() && (newData.val() == 'ON' || newData.val() == 'OFF')"
        },
        "actualState": {
          ".write": "auth != null && root.child('eldroidDeviceUids').child(auth.uid).val() == true",
          ".validate": "newData.isBoolean()"
        },
        "device": {
          ".write": "auth != null && root.child('eldroidDeviceUids').child(auth.uid).val() == true && newData.exists()",
          "lastUpdate": { ".validate": "newData.isNumber() && newData.val() == now" },
          "heartbeat": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 == 0" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },
    "recoveryChallenges": {
      ".read": false,
      ".write": false,
      ".indexOn": ["cleanupAt"]
    },
    "recoveryRateLimits": {
      ".read": false,
      ".write": false,
      ".indexOn": ["cleanupAt"]
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid && newData.exists()",
        ".validate": "newData.hasChildren(['firstName', 'lastName', 'email', 'createdAt'])",
        "firstName": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 100"
        },
        "lastName": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 100"
        },
        "email": {
          ".validate": "newData.isString() && newData.val() == auth.token.email && newData.val().length <= 254"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() == data.val())"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
